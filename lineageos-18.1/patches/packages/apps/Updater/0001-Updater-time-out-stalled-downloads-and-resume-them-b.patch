 public class UpdaterController {
 
@@ -64,6 +67,13 @@ public class UpdaterController {
     private final File mDownloadRoot;
 
     private int mActiveDownloads = 0;
+
+    private static final int MAX_AUTO_RESUMES = 5;
+    private static final long AUTO_RESUME_DELAY_MS = 10000;
+    private static final long AUTO_RESUME_WAIT_MS = 10 * 60 * 1000;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Map<String, Integer> mAutoResumes = new ConcurrentHashMap<>();
+    private final Map<String, Long> mAutoResumeWaitStart = new ConcurrentHashMap<>();
     private final Set<String> mVerifyingUpdates = new HashSet<>();
 
     protected static synchronized UpdaterController getInstance(Context context) {
@@ -204,6 +214,7 @@ public class UpdaterController {
                         removeDownloadClient(entry);
                         update.setStatus(UpdateStatus.PAUSED_ERROR);
                         notifyUpdateChange(downloadId);
+                        scheduleAutoResume(downloadId);
                     }
                 }
                 tryReleaseWakelock();
@@ -211,6 +222,50 @@ public class UpdaterController {
         };
     }
 
+    /*
+     * A download that fails on a network error (the Wi-Fi reconnected, the
+     * router moved the device to another band) resumes by itself after a few
+     * seconds, only on Wi-Fi or Ethernet so that it never moves to mobile data
+     * without the user. Up to MAX_AUTO_RESUMES resumes in a row that get no data;
+     * data received resets the count. Waiting for Wi-Fi or Ethernet does not
+     * count, for up to AUTO_RESUME_WAIT_MS.
+     */
+    private void scheduleAutoResume(String downloadId) {
+        int tries = mAutoResumes.getOrDefault(downloadId, 0);
+        if (tries >= MAX_AUTO_RESUMES) {
+            Log.d(TAG, "Not resuming " + downloadId + " by itself any more");
+            return;
+        }
+        mAutoResumes.put(downloadId, tries + 1);
+        mAutoResumeWaitStart.remove(downloadId);
+        mHandler.postDelayed(() -> autoResume(downloadId), AUTO_RESUME_DELAY_MS);
+    }
+
+    private void autoResume(String downloadId) {
+        DownloadEntry entry = mDownloads.get(downloadId);
+        if (entry == null || isDownloading(downloadId)
+                || entry.mUpdate.getStatus() != UpdateStatus.PAUSED_ERROR) {
+            mAutoResumeWaitStart.remove(downloadId);
+            return;
+        }
+        if (!Utils.isOnWifiOrEthernet(mContext)) {
+            long now = SystemClock.elapsedRealtime();
+            long waitStart = mAutoResumeWaitStart.getOrDefault(downloadId, now);
+            if (now - waitStart >= AUTO_RESUME_WAIT_MS) {
+                Log.d(TAG, "No Wi-Fi or Ethernet to resume " + downloadId + ", giving up");
+                mAutoResumeWaitStart.remove(downloadId);
+                return;
+            }
+            Log.d(TAG, "Waiting for Wi-Fi or Ethernet to resume " + downloadId);
+            mAutoResumeWaitStart.put(downloadId, waitStart);
+            mHandler.postDelayed(() -> autoResume(downloadId), AUTO_RESUME_DELAY_MS);
+            return;
+        }
+        mAutoResumeWaitStart.remove(downloadId);
+        Log.d(TAG, "Resuming " + downloadId + " after a network error");
+        resumeDownload(downloadId);
+    }
+
     private DownloadClient.ProgressListener getProgressListener(final String downloadId) {
         return new DownloadClient.ProgressListener() {
             private long mLastUpdate = 0;
@@ -222,6 +277,7 @@ public class UpdaterController {
