diff --git a/src/org/lineageos/updater/download/HttpURLConnectionClient.java b/src/org/lineageos/updater/download/HttpURLConnectionClient.java
index b9c4b5d..2162fed 100644
--- a/src/org/lineageos/updater/download/HttpURLConnectionClient.java
+++ b/src/org/lineageos/updater/download/HttpURLConnectionClient.java
@@ -36,6 +36,12 @@ public class HttpURLConnectionClient implements DownloadClient {
 
     private final static String TAG = "HttpURLConnectionClient";
 
+    // Without a read timeout a connection whose network went away (a Wi-Fi
+    // reconnection, a router moving the device to another band) blocks in
+    // read() forever and the download never fails nor resumes.
+    private final static int CONNECT_TIMEOUT_MS = 15000;
+    private final static int READ_TIMEOUT_MS = 30000;
+
     private HttpURLConnection mClient;
 
     private final File mDestination;
@@ -58,6 +64,7 @@ public class HttpURLConnectionClient implements DownloadClient {
             DownloadClient.DownloadCallback callback,
             boolean useDuplicateLinks) throws IOException {
         mClient = (HttpURLConnection) new URL(url).openConnection();
+        setTimeouts(mClient);
         mDestination = destination;
         mProgressListener = progressListener;
         mCallback = callback;
@@ -112,6 +119,11 @@ public class HttpURLConnectionClient implements DownloadClient {
         mDownloadThread.start();
     }
 
+    private static void setTimeouts(HttpURLConnection client) {
+        client.setConnectTimeout(CONNECT_TIMEOUT_MS);
+        client.setReadTimeout(READ_TIMEOUT_MS);
+    }
+
     private static boolean isSuccessCode(int statusCode) {
         return (statusCode / 100) == 2;
     }
@@ -178,6 +190,7 @@ public class HttpURLConnectionClient implements DownloadClient {
             String range = mClient.getRequestProperty("Range");
             mClient.disconnect();
             mClient = (HttpURLConnection) newUrl.openConnection();
+            setTimeouts(mClient);
             if (range != null) {
                 mClient.setRequestProperty("Range", range);
             }
